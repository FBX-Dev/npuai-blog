{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "npuai-blog",
	"compatibility_date": "2026-09-01",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"routes": [
		{
			"pattern": "www.npuai.cn",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
